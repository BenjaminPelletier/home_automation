# Copy to secrets.yaml beside notifier.yaml, or merge these keys into your
# existing ESPHome secrets.yaml. Replace every placeholder before installing.
wifi_ssid: "YOUR_2.4_GHZ_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"
# Generate a unique key using the generator linked in README.md.
notifier_api_encryption_key: "REPLACE_WITH_A_32_BYTE_BASE64_KEY"
